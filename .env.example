# Required. Keep real keys in your shell or a local .env file; never commit them.
OPENAI_API_KEY=replace-me

# Optional portable defaults used by config/agent_openai.yaml.
AGENQA_API_BASE=https://api.openai.com/v1
AGENQA_API_STYLE=responses
AGENQA_MODEL=gpt-5-mini
AGENQA_MEDIUM_MODEL=gpt-5-mini
AGENQA_STRONG_MODEL=gpt-5-mini
